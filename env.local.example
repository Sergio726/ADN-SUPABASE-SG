# ⚠️ COPIA ESTE ARCHIVO Y RENÓMBRALO A: .env.local
# Las keys se sacan del panel de Supabase (Settings → API).
# Nunca commitees .env.local ni la service role.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://vgsnfshbirzucddwbdpt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Asistente de IA (OpenRouter) — https://openrouter.ai/keys
# ⚠️ Sin prefijo NEXT_PUBLIC_: la key es de servidor y nunca debe llegar al browser.
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Modelos por modalidad (opcionales: si no se setean, se usa Gemini Flash para las tres).
# Ids de modelo de OpenRouter: https://openrouter.ai/models
# OPENROUTER_MODEL_TEXTO=google/gemini-2.5-flash
# OPENROUTER_MODEL_AUDIO=google/gemini-2.5-flash
# OPENROUTER_MODEL_IMAGEN=google/gemini-2.5-flash
